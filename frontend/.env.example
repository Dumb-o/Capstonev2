# API base URL (without /api suffix)
# Local dev: http://localhost:8000/api
# Docker: set via build arg in docker-compose.yml (http://backend:8000/api)
REACT_APP_API_URL=http://localhost:8000/api

# Contract address (optional, for direct ethers interactions)
REACT_APP_CONTRACT_ADDRESS=

# IPFS gateway URL (without /ipfs/ path suffix)
# Local dev: http://localhost:8080
# Docker: set via build arg in docker-compose.yml (http://ipfs:8080)
REACT_APP_IPFS_GATEWAY=http://localhost:8080
