{"ast":null,"code":"import{useEffect}from'react';import{useApp}from'../../context/AppContext';import{connectNotificationWs,disconnectNotificationWs}from'../../services/notificationWebSocket';export default function NotificationListener(){const{state,dispatch}=useApp();useEffect(()=>{const user=state.user;if(!user||!state.isAuthenticated)return;const token=localStorage.getItem('access_token');if(!token)return;const client=connectNotificationWs(user.id,token,dispatch);return()=>{disconnectNotificationWs();};},[state.user,state.isAuthenticated,dispatch]);return null;}","map":{"version":3,"names":["useEffect","useApp","connectNotificationWs","disconnectNotificationWs","NotificationListener","state","dispatch","user","isAuthenticated","token","localStorage","getItem","client","id"],"sources":["/home/sarun/Desktop/Capstone_Pawan_Completed/frontend/src/components/notifications/NotificationListener.js"],"sourcesContent":["import { useEffect } from 'react';\nimport { useApp } from '../../context/AppContext';\nimport { connectNotificationWs, disconnectNotificationWs } from '../../services/notificationWebSocket';\n\nexport default function NotificationListener() {\n  const { state, dispatch } = useApp();\n\n  useEffect(() => {\n    const user = state.user;\n    if (!user || !state.isAuthenticated) return;\n    const token = localStorage.getItem('access_token');\n    if (!token) return;\n\n    const client = connectNotificationWs(user.id, token, dispatch);\n\n    return () => {\n      disconnectNotificationWs();\n    };\n  }, [state.user, state.isAuthenticated, dispatch]);\n\n  return null;\n}\n"],"mappings":"AAAA,OAASA,SAAS,KAAQ,OAAO,CACjC,OAASC,MAAM,KAAQ,0BAA0B,CACjD,OAASC,qBAAqB,CAAEC,wBAAwB,KAAQ,sCAAsC,CAEtG,cAAe,SAAS,CAAAC,oBAAoBA,CAAA,CAAG,CAC7C,KAAM,CAAEC,KAAK,CAAEC,QAAS,CAAC,CAAGL,MAAM,CAAC,CAAC,CAEpCD,SAAS,CAAC,IAAM,CACd,KAAM,CAAAO,IAAI,CAAGF,KAAK,CAACE,IAAI,CACvB,GAAI,CAACA,IAAI,EAAI,CAACF,KAAK,CAACG,eAAe,CAAE,OACrC,KAAM,CAAAC,KAAK,CAAGC,YAAY,CAACC,OAAO,CAAC,cAAc,CAAC