# =============================================================================
# FreeLedger Backend — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# All values shown are safe defaults for local development.
# =============================================================================

# --- Database ---
# Primary async connection string (AsyncPG driver)
DATABASE_URL=postgresql+asyncpg://freeledger:freeledger_dev@localhost:5432/freeledger

# Synchronous connection string (for tools/scripts that don't support async)
DATABASE_URL_SYNC=postgresql://freeledger:freeledger_dev@localhost:5432/freeledger

# --- Redis ---
# Connection URL for Redis (session storage, rate limiting, caching)
REDIS_URL=redis://localhost:6379/0

# --- JWT Authentication ---
# Secret key used to sign and verify JWT tokens. CHANGE THIS IN PRODUCTION.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-this-to-a-random-secret-in-production

# JWT signing algorithm (default: HS256)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (default: 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Refresh token lifetime in days (default: 7)
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Blockchain / Web3 ---
# RPC endpoint for the blockchain node (Hardhat local node in dev)
RPC_URL=http://127.0.0.1:8545

# Chain ID (31337 = Hardhat local, 11155111 = Sepolia, 1 = Mainnet)
CHAIN_ID=31337

# Deployed GigEscrow contract address (set after running hardhat deploy)
CONTRACT_ADDRESS=

# =============================================================================
# DEDICATED WALLET CONFIGURATION (Local Development Only)
# =============================================================================
# Client and Freelancer ALWAYS use SEPARATE wallets. This is enforced by the
# authentication layer — a wallet can only ever have ONE role.
#
# Wallet Assignment (Hardhat default accounts):
#   Hardhat #0 → Client Wallet
#     Address:    0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
#     Private Key: 0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
#
#   Hardhat #1 → Freelancer Wallet
#     Address:    0x70997970C51812dc3A010C7d01b50e0d17dc79C8
#     Private Key: 0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
# =============================================================================

# PRIMARY signing key for all platform-controlled blockchain operations.
# This includes creating escrow contracts, funding, approving milestones,
# and resolving disputes.
#
# WARNING (MB-006): Single point of failure. For dev only.
CLIENT_PRIVATE_KEY=

# Freelancer signing key for milestone submissions.
# Set to Hardhat account #1 for local development.
FREELANCER_PRIVATE_KEY=

# Hardhat account index to use for the default signer (0 = first account)
HARDHAT_ACCOUNT_INDEX=0

# Timeout in seconds for individual blockchain RPC calls (Web3 provider calls).
# Prevents requests from hanging when the RPC node is slow or unresponsive.
BLOCKCHAIN_TIMEOUT=30

# Timeout in seconds for waiting on transaction receipts.
# Covers the polling period after submitting a transaction to the RPC.
BLOCKCHAIN_TX_TIMEOUT=120

# --- IPFS ---
# IPFS API endpoint (Kubo RPC API)
IPFS_API_URL=http://127.0.0.1:5001

# --- Application ---
# Platform fee in basis points (250 = 2.5%)
PLATFORM_FEE_BPS=250

# IPFS repin interval in seconds (21600 = 6 hours).
# Background service re-pins active contract terms and deliverables.
REPIN_INTERVAL_SECONDS=21600

# Comma-separated list of allowed CORS origins (for frontend access).
# In production, replace with your actual frontend domain.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:8000"]

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG
